# === DATABASE (SQLite — zero infrastructure) ===
# Leave unset to use ./sentinel.db next to the engine.
# DATABASE_URL="sqlite:///./sentinel.db"

# === AI / LLM (Groq free tier) — optional; scanner works fully without it ===
GROQ_API_KEY=""
GROQ_REASONING_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"

# === SECURITY ===
FERNET_KEY=""                 # auto-generated per process if empty
SENTINEL_ALLOW_PUBLIC="0"     # "1" allows non-sandbox targets (only with authorization)

# === ENGINE BUDGET / SAFETY ===
MAX_REQUESTS=500
MAX_CONCURRENT=5
CIRCUIT_BREAKER_ERROR_THRESHOLD=0.30
CIRCUIT_BREAKER_LATENCY_MULTIPLIER=3
REQUEST_TIMEOUT_SECONDS=10
SCAN_DEADLINE_SECONDS=300

# === DEMO TARGET ===
SENTINELSHOP_PORT=4000
SENTINELSHOP_HOST=0.0.0.0

# === ENGINE SERVER ===
SENTINEL_PORT=8000
SENTINEL_HOST=0.0.0.0
